# ShelfSync Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application URL used for generating links in emails (prevents host-header attacks)
APP_BASE_URL=http://127.0.0.1:5000

# Secret key for session security (change in production)
SECRET_KEY=dev-only-change-this-secret-key

# SMTP Email Configuration
# If SMTP_HOST is not set or empty, emails will be printed to the terminal console for development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="ShelfSync <no-reply@shelfsync.local>"

